# ============================================
# Automated Publishing Agent - Configuracoes
# ============================================
# DESENVOLVIMENTO (padroes abaixo):
#   DEBUG=True | RELOAD=True | CORS_ORIGINS=* | DATABASE_URL=sqlite://...
#
# PRODUCAO — altere obrigatoriamente:
#   DEBUG=False
#   RELOAD=False
#   CORS_ORIGINS=https://seudominio.com   (nunca * com credentials=True)
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
#   BASE_URL=https://seudominio.com
#   FRONTEND_URL=https://seudominio.com/app/login.html
#   EMAIL_RESET_URL=https://seudominio.com/app/redefinir-senha.html
# ============================================

# Configuracoes do Servidor
APP_NAME=Automated Publishing Agent
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS
# PRODUCAO: substitua * pelo dominio real (ex: https://seudominio.com)
# Nao use * com CORS_CREDENTIALS=True — o browser vai rejeitar as requisicoes.
CORS_ORIGINS=*
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# Configuracoes de Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Configuracoes de Midia
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
MAX_VIDEO_SIZE_MB=500
MAX_UPLOAD_SIZE=524288000

# Configuracoes de Agendamento
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Configuracoes de Banco de Dados
# SQLite (desenvolvimento, padrao)
DATABASE_URL=sqlite:///./automated_publishing.db

# PostgreSQL (producao) - preencha host/port/name/user/password abaixo
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automated_publishing
DB_USER=postgres
DB_PASSWORD=

# Frontend / Redirects (onde o app e servido)
FRONTEND_URL=http://localhost:8000/app/login.html
EMAIL_RESET_URL=http://localhost:8000/app/redefinir-senha.html

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OAuth por plataforma — obtenha em cada Developer Portal
# Instagram / Facebook
# IMPORTANTE: Instagram e Facebook usam o MESMO app no Meta for Developers.
# Passos para criar o app:
#   1. Acesse https://developers.facebook.com/ → "Criar app" → tipo "Business"
#   2. Adicione os produtos: "Facebook Login for Business" e "Instagram Graph API"
#   3. Em "Use Cases" → adicione as permissões:
#      Facebook: pages_show_list, pages_read_engagement, pages_manage_posts
#      Instagram: instagram_basic, instagram_content_publish, pages_read_engagement
#   4. Em "Facebook Login" → "Valid OAuth Redirect URIs" → adicione os dois URIs abaixo
#   5. A conta do Instagram precisa ser Profissional (Criador/Empresa) vinculada a uma Página
#   6. Conecte em /app/conexoes.html → "Conectar via OAuth"
#   O backend busca page_id, page_access_token e ig_user_id automaticamente após conectar.
#
# INSTAGRAM: o vídeo precisa estar em uma URL pública — configure BASE_URL abaixo.
# Em desenvolvimento use ngrok (https://ngrok.com) para expor o localhost.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/platforms/instagram/oauth/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/platforms/facebook/oauth/callback

# URL pública do backend — usada pelo Instagram para baixar o vídeo antes de publicar
# Em produção: substitua pelo domínio do seu servidor (ex: https://meuapp.com)
BASE_URL=http://localhost:8000

# YouTube (usa mesma conta Google — crie credenciais OAuth 2.0 separadas no Google Cloud Console)
# Passos:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie um projeto (ou use o existente)
#   3. Ative a "YouTube Data API v3"
#   4. Em "Credenciais" → "Criar credenciais" → "ID do cliente OAuth 2.0" → Tipo: Aplicativo da Web
#   5. Adicione http://localhost:8000/api/platforms/youtube/oauth/callback em "URIs de redirecionamento autorizados"
#   6. Copie o Client ID e o Client Secret abaixo
#   7. Em "Tela de permissão OAuth", adicione o escopo: https://www.googleapis.com/auth/youtube.upload
#   8. Conecte a conta em /app/conexoes.html → "Conectar via OAuth"
#   O access_token e refresh_token são salvos automaticamente no banco após a conexão.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/platforms/youtube/oauth/callback

# TikTok
# Passos:
#   1. Acesse https://developers.tiktok.com/ e crie um app
#   2. Adicione o produto "Content Posting API"
#   3. Solicite aprovação do escopo "video.upload"
#   4. Em "Manage app" → "Login Kit" → adicione o Redirect URI abaixo
#   5. O Client Key e o Client Secret estão em "App info" do seu app
#   6. Conecte a conta em /app/conexoes.html → "Conectar via OAuth"
#   O access_token (válido 24h) e refresh_token (válido 365 dias) são
#   salvos automaticamente. O adapter renova o token quando necessário.
#   IMPORTANTE: o upload cria um RASCUNHO na inbox do usuário.
#   O usuário precisa abrir o TikTok e confirmar a publicação no app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/platforms/tiktok/oauth/callback

# Kwai (acesso por token manual — sem OAuth publico)
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=
KWAI_REDIRECT_URI=http://localhost:8000/api/platforms/kwai/oauth/callback

# SMTP (opcional - envio real de emails de recuperacao)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@publisher.com

# Configuracoes de Plataformas - Kwai
KWAI_API_URL=https://api.kwai.com/v1/video/upload
KWAI_ACCESS_TOKEN=seu_access_token_kwai